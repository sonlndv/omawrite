# Maintainer: Son (local fork, not upstream)
# Fork of omacom-io/omawrite — adds vault, wikilinks, link graph, quick switcher.
# Packaged under a distinct pkgname so `pacman -Syu` / omarchy-update cannot
# silently replace this build with the stock `omawrite` package: this package
# Conflicts/Provides/Replaces the upstream name, so pacman treats upstream
# `omawrite` as already satisfied by this package and will not reinstall it
# alongside or over it. See the "Fork maintenance" section in ../README.md
# for the rebase-on-upstream loop.

pkgname=omawrite-son
pkgver=0.6.0.7.g20426c8
pkgrel=1
pkgdesc="Dead-simple Markdown writing app built with Qt Quick (Son's fork: vault, wikilinks, link graph, quick switcher)"
arch=('x86_64')
url='https://github.com/omacom-io/omawrite'
license=('MIT')
install='omawrite.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
provides=('omawrite')
conflicts=('omawrite')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/.."
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/-/./g'
}

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omawrite "$pkgdir/usr/bin/omawrite"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omawrite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omawrite.svg"
  /usr/bin/install -Dm644 "$startdir/omawrite.desktop" "$pkgdir/usr/share/applications/omawrite.desktop"
}
